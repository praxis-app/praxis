HOST=localhost
VITE_SERVER_PORT=3100
CLIENT_PORT=3000
AUTH_TOKEN_SECRET=replace-me
CHANNEL_KEY_MASTER=replace-me

# Database
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_SCHEMA=postgres
DB_HOST=localhost
DB_PORT=5432
DB_MIGRATIONS=false

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=redis

# LiveKit
LIVEKIT_HOST=localhost
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_PORT=7880
LIVEKIT_RTC_TCP_PORT=7881
LIVEKIT_RTC_UDP_PORT=7882
STALE_CALL_CLEANUP_INTERVAL_SECONDS=10

# Uncomment to include LiveKit and enable video calls in Docker Compose
# COMPOSE_PROFILES=livekit
