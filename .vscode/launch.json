{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Client",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "runtimeVersion": "24.18.0",
      "outputCapture": "std",
      "skipFiles": ["<node_internals>/**"],
      "restart": true
    },
    {
      "name": "Debug Server",
      "type": "lldb",
      "request": "launch",
      "preLaunchTask": "Build Server",
      "cargo": {
        "args": ["build", "--bin", "praxis-live"],
        "filter": {
          "name": "praxis-live",
          "kind": "bin"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}",
      "terminal": "console"
    },
    {
      "name": "LiveKit Server",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/dev/livekit-server.cjs",
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "outputCapture": "std",
      "skipFiles": ["<node_internals>/**"]
    }
  ],
  "compounds": [
    {
      "name": "Debug App",
      "configurations": [
        "Debug Server",
        "Debug Client",
        "LiveKit Server"
      ],
      "stopAll": true
    }
  ]
}
